*.parquet filter=lfs diff=lfs merge=lfs -text
# The small .joblib models are committed as ordinary files, not in Git LFS.
*.joblib binary
*.sh text eol=lf
# Prettier expects LF; without this, 'npm run format:check' fails on Windows with core.autocrlf=true.
frontend/src/** text eol=lf
# Raw data snapshots are checksummed byte for byte (artifacts/<version>/manifest.json, raw_data.sha256).
# Never convert their line endings, or a Windows clone with core.autocrlf=true fails the provenance checks.
backend/data/raw/*.csv -text
