# ==============================================================================
# ExoSignal Environment Configuration Template
# Copy this file to .env before starting services: cp .env.example .env
# ==============================================================================

# Application Environment (production, development, test)
EXOSIGNAL_ENV=production

# Logging Configuration (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=info
JSON_LOGS=true

# Server Configuration
PORT=8000
WORKERS=2

# CORS Allowed Origins (JSON array or comma-separated list of allowed frontend origins)
CORS_ORIGINS=["http://localhost", "http://localhost:80", "http://localhost:3000"]

# Rate Limiting (maximum API requests per minute per client IP)
RATE_LIMIT_PER_MINUTE=120
# Reverse proxies in front of the API that append to X-Forwarded-For (0 locally, 1 on Fly.io)
TRUSTED_PROXY_HOPS=0


# Frontend Configuration
# In production with Docker Compose / Nginx reverse proxy, API requests are routed via /api/v1
# On Vercel this MUST be set (the build fails without it): https://<your-backend>.fly.dev/api/v1
VITE_API_URL=http://localhost:8000
