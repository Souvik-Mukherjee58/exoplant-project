+def review_line_approves(review_text: str, planet: str, program_id: str) -> bool:
+    """True if ONE markdown table line approves (planet, program_id) with a reviewer and an ISO date."""
+    want_planet = planet.strip().casefold()
+    want_pid = program_id.strip()
+    for line in review_text.splitlines():
+        s = line.strip()
+        if not (s.startswith("|") and s.endswith("|")):
+            continue
+        cells = [c.strip() for c in s[1:-1].split("|")]
+        if len(cells) < 5 or cells[0].casefold() != want_planet or want_pid not in cells[1:]:
+            continue
+        decision = [c for c in cells if c.upper().startswith("APPROVED")]
+        dates = [c for c in cells if re.match(r"^\d{4}-\d{2}-\d{2}$", c)]
+        if not decision or not dates:
+            continue
+        used = {cells[0], want_pid, decision[0], dates[0]}
+        if any(c and c not in used and not c.lower().startswith("http") for c in cells[1:]):
+            return True
+    return False
+
